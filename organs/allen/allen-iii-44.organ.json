  "connection": {
    "record_from": "MIDI OUT",
    "play_to": "MIDI IN",
    "notes": [
      "Record from the organ's MIDI OUT (on consoles with two outputs use MIDI OUT 1, the unswitched sequencer port, so the MIDI on <division> stops need not be drawn) and play back into MIDI IN.",
      "In the organ's MIDI menu keep MIDI Expression = POLY-VOLUME, Transmit/Receive Stops = ON and the MIDI base channel at 1.",
      "Pistons send only Program Changes (general pistons on channel 8, divisionals on their division's channel), not the stops they set, so a recording registered with pistons will not capture the stops: draw stops by hand while recording, or make sure the pistons are set the same before playback."
    ]
  },
  "defaults": {
    "margin_start_ms": 2000,
    "margin_end_ms": 2000
  }
}
